{
  "bsonType": "object",
  "required": [
    "_id",
    "order_id",
    "uid",
    "scene",
    "status",
    "reward_gold",
    "created_at",
    "updated_at"
  ],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "内部 ID",
      "bsonType": "string"
    },
    "order_id": {
      "description": "广告订单号",
      "bsonType": "string"
    },
    "uid": {
      "description": "用户 ID",
      "bsonType": "string"
    },
    "scene": {
      "description": "广告场景",
      "bsonType": "string"
    },
    "reward_type": {
      "description": "服务端锁定的奖励类型",
      "bsonType": "string"
    },
    "reward_context": {
      "description": "服务端净化后的业务上下文快照，不含可直接信任的金额",
      "bsonType": "object"
    },
    "status": {
      "bsonType": "string",
      "enum": [
        "created",
        "client_completed",
        "verifying",
        "verified",
        "pending_review",
        "rewarded",
        "failed"
      ]
    },
    "reward_gold": {
      "description": "奖励金币",
      "bsonType": "int",
      "minimum": 0
    },
    "trans_id": {
      "description": "广告平台交易 ID",
      "bsonType": "string"
    },
    "device_id": {
      "description": "设备 ID",
      "bsonType": "string"
    },
    "ip": {
      "description": "IP",
      "bsonType": "string"
    },
    "ua": {
      "description": "User-Agent",
      "bsonType": "string"
    },
    "created_at": {
      "description": "创建时间",
      "bsonType": "long"
    },
    "updated_at": {
      "description": "更新时间",
      "bsonType": "long"
    },
    "callback_time": {
      "description": "回调时间",
      "bsonType": "long"
    },
    "reward_time": {
      "description": "发奖时间",
      "bsonType": "long"
    },
    "fail_reason": {
      "description": "失败原因",
      "bsonType": "string"
    },
    "idempotency_key": {
      "description": "客户端幂等键",
      "bsonType": "string"
    },
    "client_completed_at": {
      "description": "客户端完成观看上报时间，仅作遥测，不参与发奖判定",
      "bsonType": "long"
    },
    "verified_at": {
      "description": "服务端广告回调验证通过时间",
      "bsonType": "long"
    },
    "pending_review_at": {
      "description": "进入人工或延迟对账队列的时间",
      "bsonType": "long"
    },
    "reconciled_at": {
      "description": "对账完成时间",
      "bsonType": "long"
    },
    "reconciliation_status": {
      "description": "奖励对账状态",
      "bsonType": "string",
      "enum": ["not_required", "pending", "matched", "mismatch", "resolved"]
    },
    "reconciliation_note": {
      "description": "对账说明，不得包含令牌或敏感身份信息",
      "bsonType": "string"
    }
  }
}
