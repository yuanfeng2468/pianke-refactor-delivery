{
  "bsonType": "object",
  "required": ["_id", "user_id", "content", "status", "created_at", "updated_at"],
  "permission": { "read": false, "create": false, "update": false, "delete": false },
  "properties": {
    "_id": { "bsonType": "string" },
    "user_id": { "bsonType": "string" },
    "content": { "bsonType": "string", "maxLength": 500 },
    "contact": { "bsonType": "string", "maxLength": 160 },
    "status": { "bsonType": "string", "enum": ["pending", "processing", "resolved", "closed"] },
    "created_at": { "bsonType": "long" },
    "updated_at": { "bsonType": "long" }
  }
}
