  "properties": {
    "_id": { "description": "流水唯一 ID", "bsonType": "string" },
    "user_id": { "description": "用户 ID", "bsonType": "string" },
    "amount": { "description": "金币变动，收入为正、支出为负", "bsonType": "int" },
    "type": { "description": "流水类型", "bsonType": "string", "enum": ["ad_reward", "exchange_coupon", "invite_reward", "admin_adjustment", "checkin_reward"] },
    "source": { "description": "业务来源", "bsonType": "string" },
    "trans_id": { "description": "奖励或兑换事务唯一键", "bsonType": "string" },
    "description": { "description": "面向运营的流水说明", "bsonType": "string" },
