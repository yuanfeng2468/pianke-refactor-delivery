{
  "bsonType": "object",
  "required": ["_id", "user_id", "code_input", "result", "created_at"],
  "permission": { "read": false, "create": false, "update": false, "delete": false },
  "properties": {
    "_id": { "bsonType": "string" },
    "event_id": { "bsonType": "string" },
    "user_id": { "bsonType": "string" },
    "code_input": { "bsonType": "string" },
    "result": { "bsonType": "string", "enum": ["success", "failed", "expired", "exceeded"] },
    "message": { "bsonType": "string" },
    "ip_address": { "bsonType": "string" },
    "device_id": { "bsonType": "string" },
    "user_agent": { "bsonType": "string" },
    "created_at": { "bsonType": "long" }
  }
}
